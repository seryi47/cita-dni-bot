# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Datos del DNI actual (para autenticarte en citapreviadnie.es) ---
# Todos estos datos están impresos en tu DNI físico actual (el que vas a renovar).
# NO se envían a nadie salvo al propio sitio oficial citapreviadnie.es

# Número del DNI, SIN la letra final. Ej: si tu DNI es 12345678Z -> 12345678
DNI_NUM_DOCUMENTO=

# La letra final del DNI. Ej: Z
DNI_LETRA_DOCUMENTO=

# "Equipo de Expedición": código de 9 caracteres en el frente del DNI 3.0,
# cerca de donde dice "IDESP" / junto a la foto.
DNI_COD_EQUIPO=

# Fecha de Validez (caducidad) del DNI actual, formato dd/mm/aaaa
DNI_FECHA_VALIDEZ=

# "Número de Soporte": código de 9 caracteres, normalmente en el reverso
# del DNI (o en el frente en el DNI 3.0), cerca del número de serie.
DNI_NUM_SOPORTE=

# Si tu DNI actual es del modelo nuevo europeo "DNI 4.0" pon true, si no dejalo en false
DNI_ES_MODELO_4_0=false
